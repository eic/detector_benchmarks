# Generate HepMC input for b0 tracker benchmark
rule b0_tracker_hepmc:
    input:
        script = workflow.source_path("scripts/gen_forward_protons.cxx"),
    output:
        hepmcfile="sim_output/b0_tracker/forward_protons.hepmc",
    params:
        num_events=100,
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
root -l -b -q '{input.script}({params.num_events}, 0, "{output.hepmcfile}")'
"""


# Run the generated events through Geant4 simulation
rule b0_tracker_sim:
    input:
        hepmcfile="sim_output/b0_tracker/forward_protons.hepmc",
        warmup="warmup.edm4hep.root",
        geometry_lib=find_epic_libraries(),
    output:
        "sim_output/b0_tracker/{DETECTOR_CONFIG}/sim_forward_protons.edm4hep.root",
    params:
        num_events=100,
        DETECTOR_CONFIG=lambda wildcards: wildcards.DETECTOR_CONFIG,
        DD4HEP_HASH=get_spack_package_hash("dd4hep"),
        NPSIM_HASH=get_spack_package_hash("npsim"),
    cache: True
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
exec npsim \
  --runType batch \
  -v WARNING \
  --part.minimalKineticEnergy 0.5*GeV \
  --filter.tracker edep0 \
  --compactFile $DETECTOR_PATH/{wildcards.DETECTOR_CONFIG}.xml \
  --random.seed 1 \
  --numberOfEvents {params.num_events} \
  --inputFiles {input.hepmcfile} \
  --outputFile {output}
"""


# Run analysis script to produce b0 tracker plots
rule b0_tracker_analysis:
    input:
        analysis_script = workflow.source_path("analysis/b0_tracker_hits.cxx"),
        data = "sim_output/b0_tracker/{DETECTOR_CONFIG}/sim_forward_protons.edm4hep.root",
    output:
        "results/far_forward/b0/hits_eta.png",
        "results/far_forward/b0/hits_eta.pdf",
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
mkdir -p results/far_forward/b0
root -l -b -q '{input.analysis_script}+("{input.data}")'
"""
