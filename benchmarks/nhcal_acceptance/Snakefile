rule nhcal_acceptance_simulate:
    input:
        warmup="warmup.edm4hep.root",
        geometry_lib=find_epic_libraries(),
    output:
        "sim_output/nhcal_acceptance/E{ENERGY}GeV/sim_{DETECTOR_CONFIG}.{INDEX}.edm4hep.rnt.root",
    params:
        N_EVENTS=10000,
        SEED=lambda wildcards: "1" + wildcards.INDEX,
        DETECTOR_PATH=config["DETECTOR_PREFIX"] + "/share/epic",
        DETECTOR_CONFIG=lambda wildcards: wildcards.DETECTOR_CONFIG,
        ENERGY=lambda wildcards: wildcards.ENERGY,
        DD4HEP_HASH=get_spack_package_hash("dd4hep"),
        NPSIM_HASH=get_spack_package_hash("npsim"),
    cache: True
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
exec npsim \
    --compactFile {params.DETECTOR_PATH}/{params.DETECTOR_CONFIG}.xml \
    --numberOfEvents {params.N_EVENTS} \
    --random.seed {params.SEED} \
    --enableGun \
    -v WARNING \
    --gun.particle pi- \
    --gun.thetaMin 120*degree \
    --gun.thetaMax 180*degree \
    --gun.distribution uniform \
    --gun.energy "{params.ENERGY}*GeV" \
    --outputConfig.useRNTuple true \
    --outputFile {output}
"""


rule nhcal_acceptance_analysis:
    input:
        sim=lambda wildcards: expand(
            "sim_output/nhcal_acceptance/E{ENERGY}GeV/sim_{DETECTOR_CONFIG}.{INDEX:02d}.edm4hep.rnt.root",
            DETECTOR_CONFIG=wildcards.DETECTOR_CONFIG,
            ENERGY=wildcards.ENERGY,
            INDEX=range(int(wildcards.N)),
        ),
        script=workflow.source_path("scripts/acceptance_analysis.cxx"),
    output:
        png=f"results/nhcal_acceptance/analysis_{{DETECTOR_CONFIG}}_E{{ENERGY}}GeV_combined_{{N}}files.png",
        pdf=f"results/nhcal_acceptance/analysis_{{DETECTOR_CONFIG}}_E{{ENERGY}}GeV_combined_{{N}}files.pdf",
    wildcard_constraints:
        N=r"\d+",
        ENERGY=r"\d+",
    params:
        # podio::makeReader expands glob patterns, so no need to hadd the inputs
        SIM_GLOB=lambda wildcards: f"sim_output/nhcal_acceptance/E{wildcards.ENERGY}GeV/sim_{wildcards.DETECTOR_CONFIG}.*.edm4hep.rnt.root",
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
    root -l -b -q '{input.script}("{params.SIM_GLOB}","{output.pdf}","{output.png}")'
"""
