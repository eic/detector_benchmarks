rule nhcal_pion_rejection_simulate:
    input:
        geometry_lib=find_epic_libraries(),
    output:
        "sim_output/nhcal_pion_rejection/sim_{DETECTOR_CONFIG}.{INDEX}.edm4hep.rnt.root",
    params:
        N_EVENTS=1000,
        SEED=lambda wildcards: "1" + wildcards.INDEX,
        DETECTOR_PATH=config["DETECTOR_PREFIX"] + "/share/epic",
        DETECTOR_CONFIG=lambda wildcards: wildcards.DETECTOR_CONFIG,
        DD4HEP_HASH=get_spack_package_hash("dd4hep"),
        NPSIM_HASH=get_spack_package_hash("npsim"),
    wildcard_constraints:
        INDEX = r"\d+",
    cache: True
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
exec npsim \
    --compactFile {params.DETECTOR_PATH}/{params.DETECTOR_CONFIG}.xml \
    --numberOfEvents {params.N_EVENTS} \
    --random.seed {params.SEED} \
    --enableGun \
    -v WARNING \
    --gun.particle pi- \
    --gun.thetaMin 120*degree \
    --gun.thetaMax 180*degree \
    --gun.distribution uniform \
    --gun.momentumMin "1*GeV" \
    --gun.momentumMax "18*GeV" \
    --outputConfig.useRNTuple true \
    --outputFile {output}
"""

rule nhcal_pion_rejection_recon:
    input:
        "sim_output/nhcal_pion_rejection/sim_{DETECTOR_CONFIG}.{INDEX}.edm4hep.rnt.root"
    output:
        "sim_output/nhcal_pion_rejection/sim_{DETECTOR_CONFIG}.{INDEX}.eicrecon.edm4hep.root"
    params:
        DETECTOR_CONFIG = lambda wildcards: wildcards.DETECTOR_CONFIG,
        EICRECON_HASH=get_spack_package_hash("eicrecon"),
    cache: True
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
exec env DETECTOR_CONFIG={params.DETECTOR_CONFIG} \
          eicrecon {input} \
          -Ppodio:output_file={output} \

"""

rule nhcal_pion_rejection_analysis:
    input:
        recon=lambda wildcards: expand(
            "sim_output/nhcal_pion_rejection/sim_{DETECTOR_CONFIG}.{INDEX}.eicrecon.edm4hep.root",
            DETECTOR_CONFIG=wildcards.DETECTOR_CONFIG,
            INDEX=range(int(wildcards.N)),
        ),
        script=workflow.source_path("scripts/pion_rejection_analysis.cxx"),
    output:
        png="results/nhcal_pion_rejection/analysis_{DETECTOR_CONFIG}_{N}files.png",
        pdf="results/nhcal_pion_rejection/analysis_{DETECTOR_CONFIG}_{N}files.pdf",
    wildcard_constraints:
        N=r"\d+",
    params:
        DETECTOR_PATH   = config["DETECTOR_PREFIX"] + "/share/epic",
        DETECTOR_CONFIG = lambda wildcards: f"{wildcards.DETECTOR_CONFIG}.xml",
        # podio::makeReader expands glob patterns, so no need to hadd the inputs
        RECON_GLOB = lambda wildcards: f"sim_output/nhcal_pion_rejection/sim_{wildcards.DETECTOR_CONFIG}.*.eicrecon.edm4hep.root",
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
    root -l -b -q '{input.script}+("{params.RECON_GLOB}","{output.pdf}","{output.png}","{params.DETECTOR_PATH}/{params.DETECTOR_CONFIG}")'
"""
