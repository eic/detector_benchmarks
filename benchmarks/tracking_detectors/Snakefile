# Generate HepMC input for track hits benchmark
rule tracking_detectors_hepmc:
    input:
        script = workflow.source_path("scripts/gen_track_hits.cxx"),
    output:
        hepmcfile="sim_output/tracking_detectors/track_hits.hepmc",
    params:
        num_events=100,
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
root -l -b -q '{input.script}({params.num_events}, "{output.hepmcfile}")'
"""


# Run the generated events through Geant4 simulation
rule tracking_detectors_sim:
    input:
        hepmcfile="sim_output/tracking_detectors/track_hits.hepmc",
        warmup="warmup.edm4hep.root",
        geometry_lib=find_epic_libraries(),
    output:
        "sim_output/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits.edm4hep.root",
    params:
        num_events=100,
        DETECTOR_CONFIG=lambda wildcards: wildcards.DETECTOR_CONFIG,
        DD4HEP_HASH=get_spack_package_hash("dd4hep"),
        NPSIM_HASH=get_spack_package_hash("npsim"),
    cache: True
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
exec npsim \
  --runType batch \
  --part.minimalKineticEnergy 1000*GeV \
  --filter.tracker edep0 \
  -v WARNING \
  --compactFile $DETECTOR_PATH/{wildcards.DETECTOR_CONFIG}.xml \
  --random.seed 1 \
  --numberOfEvents {params.num_events} \
  --inputFiles {input.hepmcfile} \
  --outputFile {output}
"""


# Run analysis scripts to produce plots
rule tracking_detectors_analysis:
    input:
        analysis_script = workflow.source_path("analysis/sim_track_hits.cxx"),
        data = "sim_output/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits.edm4hep.root",
    output:
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_n_hits_vs_theta.png",
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_n_hits_vs_theta.pdf",
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_n_hits.png",
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_n_hits.pdf",
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_theta.png",
        "results/tracking_detectors/{DETECTOR_CONFIG}/sim_track_hits_theta.pdf",
    singularity: EIC_SINGULARITY_CONTAINER,
    shell:
        """
mkdir -p results/tracking_detectors/{wildcards.DETECTOR_CONFIG}
root -l -b -q '{input.analysis_script}+("{input.data}")'
"""
